<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jiang</groupId>
    <artifactId>finance-agent</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- MySQL 驱动：负责 Java 与 MySQL 之间的通信 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
        </dependency>

        <!-- Jackson：构造/解析 LLM 的 JSON 报文。版本与 graph-core 对齐（见下方依赖说明） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.19.4</version>
        </dependency>

        <!--
            JSqlParser：SQL 语法解析器。
            为什么不自己写正则校验？见 SqlGuard 类注释 —— 正则会漏，且漏得很有规律。
            MyBatis-Plus 的分页插件内部也是用它做 SQL 改写的，Java 生态事实标准。
        -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>5.1</version>
        </dependency>

        <!--
            ★ 第 9 步新增：Spring AI Alibaba Graph —— 把主循环重构成「节点 + 条件边」的图。

            【为什么用它，而不是自己写一个循环】
              第 4 步的手写主循环能跑，但它有个结构性弱点：流程藏在 Java 的 for/if 里，
              外部看不见、没法单独测、也没法在中间插审计点。
              图编排把流程变成一等公民：节点是数据、边是数据，可以画出来、可以逐节点验证、
              可以在任意节点挂拦截器。

            【关于依赖体量 —— 我实测过，不是拍脑袋】
              这个包并不轻，会把整个 Spring AI 1.1.2 模型栈拖进来
              （spring-ai-client-chat / spring-ai-rag / spring-ai-deepseek / reactor-core …），
              实测 classpath 共 70 个 jar。

              但我验证过一个关键前提：**它的图引擎不需要 Spring 容器**。
              `new StateGraph()` 就是普通 Java 对象，NodeAction 就是个函数式接口，
              所以本项目仍然是一个 `java -cp ... Step9Main` 就能跑的控制台程序，
              不必引入 Spring Boot、也不必改 dev.sh。

            【版本对齐】
              它依赖 jackson-databind 2.19.4，本项目原先锁的是 2.17.2。
              Maven 的就近原则会让「直接声明」的 2.17.2 胜出，
              所以这里把本项目也一起升到 2.19.4，避免同一个库出现两个版本。
              2.19 对 2.17 是向后兼容的，原有代码不用改。
        -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-graph-core</artifactId>
            <version>1.1.2.4-security-fix</version>
        </dependency>
    </dependencies>
</project>
